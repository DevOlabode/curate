{
  "name": "curate",
  "version": "1.0.2",
  "description": "Private bookmark library for developers, as a Chrome and Edge extension",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevOlabode/curate.git"
  },
  "bugs": {
    "url": "https://github.com/DevOlabode/curate/issues"
  },
  "homepage": "https://github.com/DevOlabode/curate#readme",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build:extension": "node scripts/build-extension.js",
    "build:extension:production": "node scripts/build-extension.js --env=production",
    "build:extension:staging": "node scripts/build-extension.js --env=staging",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "keywords": [
    "bookmarks",
    "browser-extension",
    "chrome-extension",
    "edge-extension"
  ],
  "author": "Samuel Olabode",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "ejs": "^3.1.10",
    "ejs-mate": "^4.0.0",
    "express": "^5.1.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.0",
    "nodemailer": "^9.0.5",
    "nodemon": "^3.1.11",
    "passport-local-mongoose": "^8.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "pngjs": "^7.0.0",
    "supertest": "^7.2.2"
  }
}
