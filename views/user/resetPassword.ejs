<%- layout('./layout/boilerplate.ejs') %>

<div class="auth-shell">
  <div class="container">
    <p class="page-kicker text-center">Account</p>
    <h2 class="mb-4 text-center">Choose a new password</h2>

    <form action="/reset-password/<%= token %>" method="POST" class="needs-validation form-card mx-auto" novalidate>
        <div class="mb-3">
            <label for="password" class="form-label">New password</label>
            <input type="password" id="password" name="password" class="form-control" minlength="8" required>
            <div class="invalid-feedback">Use at least 8 characters.</div>
        </div>
        <div class="mb-3">
            <label for="confirmPassword" class="form-label">Confirm password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" minlength="8" required>
            <div class="invalid-feedback">Please confirm your password.</div>
        </div>
        <button class="btn btn-success w-100">Update password</button>
        <p class="text-muted text-center mt-4 mb-0"><a href="/login">Back to log in</a></p>
    </form>
  </div>
</div>
