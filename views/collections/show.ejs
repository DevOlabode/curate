<%- layout('./layout/boilerplate.ejs') %>

<div class="container">
  <div class="page-header">
    <div>
      <p class="page-kicker">Collection</p>
      <h2><%= collection.name %></h2>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a href="/collections/<%= collection._id %>/bookmarks/new" class="btn btn-primary">Add bookmark</a>
      <a href="/collections/<%= collection._id %>/edit" class="btn btn-warning">Edit</a>
      <form action="/collections/<%= collection._id %>?_method=delete" method="post">
        <button class="btn btn-danger">Delete</button>
      </form>
      <a href="/collections" class="btn btn-secondary">Back</a>
    </div>
  </div>

  <% if(collection.bookmarks.length === 0){ %>
    <div class="empty-state">
      <i class="fas fa-bookmark fa-2x mb-3"></i>
      <h4>No bookmarks yet</h4>
      <p class="text-muted">Add bookmarks to this collection.</p>
    </div>
  <% } else { %>
    <ul class="list-group">
      <% for(let bookmark of collection.bookmarks){ %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center">
            <i class="fas fa-bookmark text-primary me-3"></i>
            <a href="/collections/<%= collection._id %>/bookmarks/<%= bookmark._id %>" class="text-decoration-none text-dark fw-bold">
              <%= bookmark.title %>
            </a>
            <span class="badge bg-secondary ms-2"><%= bookmark.category %></span>
          </div>
          <div class="d-flex gap-2">
            <a href="/collections/<%= collection._id %>/bookmarks/<%= bookmark._id %>" class="btn btn-sm btn-outline-primary">
              <i class="fas fa-eye"></i>
            </a>
            <a href="/collections/<%= collection._id %>/bookmarks/<%= bookmark._id %>/edit" class="btn btn-sm btn-outline-warning">
              <i class="fas fa-edit"></i>
            </a>
            <form action="/collections/<%= collection._id %>/bookmarks/<%= bookmark._id %>?_method=delete" method="POST" style="display: inline;">
              <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="fas fa-trash"></i>
              </button>
            </form>
          </div>
        </li>
      <% } %>
    </ul>
  <% } %>
</div>
