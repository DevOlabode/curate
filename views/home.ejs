<%- layout('./layout/boilerplate.ejs') %>

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-kicker">Browser extension</div>
        <h1 class="hero-title">
          Keep the links worth <span class="highlight">coming back to.</span>
        </h1>
        <p class="hero-description">
          Curate is a popup for developers. Save tools, docs, and references, then group them into collections that stay useful.
        </p>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">Save</span>
            <span class="stat-label">From the toolbar</span>
          </div>
          <div class="stat">
            <span class="stat-number">Sort</span>
            <span class="stat-label">Tags and collections</span>
          </div>
          <div class="stat">
            <span class="stat-number">Return</span>
            <span class="stat-label">Whenever you need it</span>
          </div>
        </div>
        <div class="hero-cta" id="download">
          <% if (chromeStoreUrl) { %>
          <a href="<%= chromeStoreUrl %>" class="btn btn-primary btn-lg" rel="noopener noreferrer">Add to Chrome</a>
          <% } else { %>
          <span class="btn btn-primary btn-lg is-disabled" aria-disabled="true">Add to Chrome · Coming soon</span>
          <% } %>
          <% if (edgeStoreUrl) { %>
          <a href="<%= edgeStoreUrl %>" class="btn btn-outline-light btn-lg" rel="noopener noreferrer">Add to Edge</a>
          <% } else { %>
          <span class="btn btn-outline-light btn-lg is-disabled" aria-disabled="true">Add to Edge · Coming soon</span>
          <% } %>
        </div>
        <p class="install-note">After installing, click the Curate icon in your toolbar and sign in.</p>
      </div>
      <div class="hero-visual">
        <div class="popup-mock" aria-hidden="true">
          <div class="popup-mock-bar">
            <span class="popup-mock-dot"></span>
            <span>Curate</span>
          </div>
          <div class="popup-mock-row">
            <strong>React Documentation</strong>
            <span>react.dev</span>
          </div>
          <div class="popup-mock-row">
            <strong>Node.js API Guide</strong>
            <span>nodejs.org</span>
          </div>
          <div class="popup-mock-row">
            <strong>CSS Grid Layout</strong>
            <span>developer.mozilla.org</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="steps">
  <div class="container">
    <div class="section-header">
      <p class="page-kicker">How it works</p>
      <h2>Install once. Find it forever.</h2>
      <p>A simple ritual for the resources you refuse to lose in a browser graveyard.</p>
    </div>
    <div class="steps-grid">
      <div class="step-item">
        <div class="step-num">01</div>
        <h3>Install</h3>
        <p>Add Curate to Chrome or Edge, then pin it to your toolbar.</p>
      </div>
      <div class="step-item">
        <div class="step-num">02</div>
        <h3>Capture</h3>
        <p>Open the popup, sign in, and save a URL with a title, tags, and a category.</p>
      </div>
      <div class="step-item">
        <div class="step-num">03</div>
        <h3>Arrange</h3>
        <p>File related links into collections so related work lives together.</p>
      </div>
    </div>
  </div>
</section>

<section class="features">
  <div class="container">
    <div class="section-header">
      <p class="page-kicker">What you get</p>
      <h2>A library that lives in your toolbar.</h2>
      <p>These are the features in the extension today.</p>
    </div>
    <div class="features-grid">
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-bookmark"></i></div>
        <h3>Bookmarks</h3>
        <p>Save a title, URL, category, and tags from the popup, then open them later in one click.</p>
      </div>
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-layer-group"></i></div>
        <h3>Collections</h3>
        <p>Group related bookmarks into named sets you can reopen as a whole.</p>
      </div>
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-user"></i></div>
        <h3>Sign in from the popup</h3>
        <p>Create an account or log in without leaving the extension.</p>
      </div>
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-lock"></i></div>
        <h3>Private by default</h3>
        <p>Your notes and links stay with your account, not a public feed.</p>
      </div>
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-moon"></i></div>
        <h3>Light and dark</h3>
        <p>A warm editorial look that stays readable from desk to late night.</p>
      </div>
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-feather"></i></div>
        <h3>Quiet UI</h3>
        <p>Your library is the home screen. Forms appear only when you add something.</p>
      </div>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <div class="cta-content">
      <h2>Get the extension.</h2>
      <p>Install Curate, open the popup, and save the first link.</p>
      <div class="hero-cta justify-content-center">
        <% if (chromeStoreUrl) { %>
        <a href="<%= chromeStoreUrl %>" class="btn btn-primary btn-lg" rel="noopener noreferrer">Add to Chrome</a>
        <% } else { %>
        <span class="btn btn-primary btn-lg is-disabled" aria-disabled="true">Add to Chrome · Coming soon</span>
        <% } %>
        <% if (edgeStoreUrl) { %>
        <a href="<%= edgeStoreUrl %>" class="btn btn-outline-light btn-lg" rel="noopener noreferrer">Add to Edge</a>
        <% } else { %>
        <span class="btn btn-outline-light btn-lg is-disabled" aria-disabled="true">Add to Edge · Coming soon</span>
        <% } %>
      </div>
    </div>
  </div>
</section>
