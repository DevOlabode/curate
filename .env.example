# Database
MONGO_URI=mongodb://localhost:27017/developerBookmarks

# Web session (server only)
SESSION_SECRET=change-me-in-production

# Extension API JWT (server only - never ship in the extension)
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# Optional public URL used in password-reset emails
APP_URL=http://localhost:3000

# Extension store listings (leave empty until published)
CHROME_STORE_URL=
EDGE_STORE_URL=

# Brevo SMTP (server only - never ship in the extension)
BREVO_SMTP_KEY=
BREVO_USER=
BREVO_FROM=

