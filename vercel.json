{
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": { "includeFiles": "views/**" }
  },
  "git": {
    "deploymentEnabled": {
      "feature/**": false,
      "fix/**": false,
      "docs/**": false,
      "hotfix/**": false,
      "dependabot/**": false
    }
  }
}
