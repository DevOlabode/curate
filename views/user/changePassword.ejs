<%- layout('./layout/boilerplate.ejs') %>

<div class="container">
  <p class="page-kicker">Account</p>
  <h2 class="mb-4">Change your password</h2>
  <form action="/user/change-password?_method=put" method="POST" class="needs-validation form-card" novalidate>
    <div class="mb-3">
        <label for="currentPassword" class="form-label">Current password</label>
        <input type="password" id="currentPassword" name="currentPassword" class="form-control">
    </div>
    <div class="mb-3">
        <label for="newPassword" class="form-label">New password</label>
        <input type="password" id="newPassword" name="newPassword" class="form-control">
    </div>
    <div class="mb-3">
        <label for="confirmPassword" class="form-label">Confirm new password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control">
    </div>
    <div class="form-actions">
      <button class="btn btn-success">Update password</button>
      <a href="/user/info" class="btn btn-secondary">Back</a>
    </div>
  </form>
</div>
