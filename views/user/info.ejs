<%- layout('./layout/boilerplate.ejs') %>

<div class="container">
    <p class="page-kicker">Account</p>
    <h2 class="mb-4">Your profile</h2>

    <ul class="list-group detail-panel" style="max-width: 640px;">
        <li class="list-group-item">
            <strong>First name</strong> <span class="ms-2"><%= currentUser.firstName %></span>
        </li>
        <li class="list-group-item">
            <strong>Last name</strong> <span class="ms-2"><%= currentUser.lastName %></span>
        </li>
        <li class="list-group-item">
            <strong>Username</strong> <span class="ms-2"><%= currentUser.username %></span>
        </li>
        <li class="list-group-item">
            <strong>Email</strong> <span class="ms-2"><%= currentUser.email %></span>
        </li>
    </ul>

    <div class="d-flex mt-4">
        <button class="btn btn-warning" id="editUser" type="button">Edit profile</button>
    </div>

    <form action="/user" method="POST" class="needs-validation pw form-card" novalidate>
        <label for="password" class="form-label">Confirm with your password</label>
        <input type="password" name="password" class="form-control" id="password" placeholder="Please enter your password" required>
        <div class="form-actions mt-3">
            <button class="btn btn-info">Continue</button>
        </div>
    </form>
</div>
