<%- layout('./layout/boilerplate.ejs') %>

<div class="auth-shell">
  <div class="container">
    <p class="page-kicker text-center">Account</p>
    <h2 class="mb-4 text-center">Forgot password</h2>
    <p class="text-muted text-center" style="max-width: 460px; margin: 0 auto 24px;">
      Enter the email on your account and we’ll send a link to choose a new password.
    </p>

    <form action="/forgot-password" method="POST" class="needs-validation form-card mx-auto" novalidate>
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-control" placeholder="you@example.com" required>
            <div class="invalid-feedback">Please enter your email.</div>
        </div>
        <button class="btn btn-success w-100">Send reset link</button>
        <p class="text-muted text-center mt-4 mb-0"><a href="/login">Back to log in</a></p>
    </form>
  </div>
</div>
