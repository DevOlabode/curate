<%- layout('./layout/boilerplate.ejs') %>

<div class="container">
  <div class="page-header">
    <div>
      <p class="page-kicker">Collections</p>
      <h2>Your collections</h2>
      <p class="text-muted mb-0">Group related bookmarks into sets you can reopen as a whole.</p>
    </div>
    <a href="/collections/new" class="btn btn-primary">New collection</a>
  </div>

  <% if(collections.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-folder-open fa-2x mb-3"></i>
      <h4>No collections yet</h4>
      <p class="text-muted">Start by creating a collection to group and organize your bookmarks.</p>
      <a href="/collections/new" class="btn btn-primary">Create one</a>
    </div>
  <% } else { %>
    <ul class="list-group">
      <% for(let collection of collections){ %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <a href="/collections/<%= collection._id %>" class="text-decoration-none text-dark fw-bold">
              <%= collection.name %>
            </a>
            <% if (collection.description) { %>
              <p class="mb-0 text-muted small"><%= collection.description %></p>
            <% } else { %>
              <p class="mb-0 text-muted small fst-italic">No description provided</p>
            <% } %>
          </div>
        </li>
      <% } %>
    </ul>
  <% } %>
</div>
