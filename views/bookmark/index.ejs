<%- layout('./layout/boilerplate.ejs') %>

<div class="container">
  <div class="page-header">
    <div>
      <p class="page-kicker">Library</p>
      <h2>Your bookmarks</h2>
      <p class="text-muted mb-0">Everything you’ve chosen to keep close.</p>
    </div>
    <a href="/bookmark/new" class="btn btn-primary">Add bookmark</a>
  </div>

  <% if(bookmarks.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-bookmark fa-2x mb-3"></i>
      <h4>No bookmarks yet</h4>
      <p class="text-muted">Save the first link and start building your library.</p>
      <a href="/bookmark/new" class="btn btn-primary">Create one</a>
    </div>
  <% } else { %>
    <ul class="list-group">
      <% for(let bookmark of bookmarks){ %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center">
            <i class="fas fa-bookmark text-primary me-3"></i>
            <a href="/bookmark/<%= bookmark._id %>" class="text-decoration-none text-dark fw-bold">
              <%= bookmark.title %>
            </a>
            <% if (bookmark.category) { %>
            <span class="badge bg-secondary ms-2"><%= bookmark.category %></span>
            <% } %>
          </div>
          <div class="d-flex gap-2">
            <a href="/bookmark/<%= bookmark._id %>" class="btn btn-sm btn-outline-primary">
              <i class="fas fa-eye"></i>
            </a>
            <a href="/bookmark/<%= bookmark._id %>/edit" class="btn btn-sm btn-outline-warning">
              <i class="fas fa-edit"></i>
            </a>
            <form action="/bookmark/<%= bookmark._id %>?_method=DELETE" method="POST" style="display: inline;">
              <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="fas fa-trash"></i>
              </button>
            </form>
          </div>
        </li>
      <% } %>
    </ul>
  <% } %>
</div>
