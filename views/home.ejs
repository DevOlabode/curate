<%- layout('./layout/boilerplate.ejs') %>

<header class="soon-header">
  <a class="soon-brand" href="/">
    <img class="soon-logo" src="/images/download.svg" alt="" width="32" height="32">
    Curate
  </a>
  <div class="soon-header-actions">
    <a href="#about">About</a>
    <a href="#features">Features</a>
    <a href="/privacy">Privacy</a>
    <a class="soon-install" href="<%= chromeStoreUrl %>" target="_blank" rel="noopener noreferrer">Chrome</a>
    <a class="soon-install" href="<%= edgeStoreUrl %>" target="_blank" rel="noopener noreferrer">Edge</a>
    <button id="theme-toggle" class="btn btn-sm" aria-label="Toggle theme" title="Toggle dark/light mode">
      <i class="fas fa-moon"></i>
    </button>
  </div>
</header>

<main class="soon-page">
  <section class="soon-hero">
    <p class="soon-eyebrow">Browser extension</p>
    <h1>Keep the links you actually return to.</h1>
    <p class="soon-lede">
      Curate is a private library in your toolbar. Save docs, repos, tools, and articles from a popup, file them into collections, and find them again without hunting through a bookmarks bar.
    </p>
    <div class="soon-cta">
      <a class="soon-store-btn" href="<%= chromeStoreUrl %>" target="_blank" rel="noopener noreferrer">Add to Chrome</a>
      <a class="soon-store-btn is-secondary" href="<%= edgeStoreUrl %>" target="_blank" rel="noopener noreferrer">Add to Edge</a>
    </div>
    <div class="soon-meta">
      <span>Available on Chrome</span>
      <span>Available on Edge</span>
      <span>Private accounts</span>
    </div>
  </section>

  <section class="soon-section">
    <div class="soon-section-head">
      <h2 id="about">What it is</h2>
    </div>
    <div class="soon-prose">
      <p>
        Bookmark bars fill up and then get ignored. Social bookmarking tools ask you to publish. Curate is neither. It is a small, quiet place for the development links you keep reopening.
      </p>
      <p>
        You sign in inside the popup. You save a URL with a title, a category, and tags. You can leave it in the main library or drop it into a collection. Next time the popup opens, that library is the first thing you see.
      </p>
    </div>
  </section>

  <section class="soon-section">
    <div class="soon-section-head">
        <h2 id="features">What it includes</h2>
    </div>
    <ol class="soon-features">
      <li>
        <span class="soon-index">01</span>
        <div>
          <h3>Bookmarks</h3>
          <p>Save a title, URL, category, and tags from the popup. Open the link later in one click. Edit or delete it without leaving the extension.</p>
        </div>
      </li>
      <li>
        <span class="soon-index">02</span>
        <div>
          <h3>Collections</h3>
          <p>Group related bookmarks into named sets: a stack you are learning, a project you are shipping, a topic you refuse to lose. Open a collection and add straight into it.</p>
        </div>
      </li>
      <li>
        <span class="soon-index">03</span>
        <div>
          <h3>Accounts in the popup</h3>
          <p>Create an account or sign in from the extension. Edit your profile, change your password, log out, or delete your account there. This website is not where you manage your library.</p>
        </div>
      </li>
      <li>
        <span class="soon-index">04</span>
        <div>
          <h3>Private by default</h3>
          <p>Links and notes stay on your account. There is no public feed, no sharing wall, and no one else browsing what you saved.</p>
        </div>
      </li>
      <li>
        <span class="soon-index">05</span>
        <div>
          <h3>Light and dark</h3>
          <p>The popup stays readable in both modes, so it works at a desk or late at night without becoming a different product.</p>
        </div>
      </li>
      <li>
        <span class="soon-index">06</span>
        <div>
          <h3>Library first</h3>
          <p>The home screen is your collections and bookmarks. Forms stay hidden until you add or edit something.</p>
        </div>
      </li>
    </ol>
  </section>
</main>

<section class="soon-close" id="install">
  <div class="soon-close-inner">
    <p class="soon-eyebrow">Install</p>
    <h2>On Chrome and Edge.</h2>
    <p>
      Get Curate from the Chrome Web Store or Microsoft Edge Add-ons. There is no web signup on this site. Sign in inside the popup.
    </p>
    <div class="soon-cta">
      <a class="soon-store-btn" href="<%= chromeStoreUrl %>" target="_blank" rel="noopener noreferrer">Add to Chrome</a>
      <a class="soon-store-btn is-secondary" href="<%= edgeStoreUrl %>" target="_blank" rel="noopener noreferrer">Add to Edge</a>
    </div>
  </div>
</section>

<%- include('partials/footer.ejs') %>
