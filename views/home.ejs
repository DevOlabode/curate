<%- layout('./layout/boilerplate.ejs') %>

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-kicker">Personal knowledge library</div>
        <h1 class="hero-title">
          Keep the links worth <span class="highlight">coming back to.</span>
        </h1>
        <p class="hero-description">
          Curate is a calm space for developers to save, tag, and revisit tools, docs, and references — organized into collections that actually stay useful.
        </p>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">Save</span>
            <span class="stat-label">Anything useful</span>
          </div>
          <div class="stat">
            <span class="stat-number">Sort</span>
            <span class="stat-label">By tags & collections</span>
          </div>
          <div class="stat">
            <span class="stat-number">Return</span>
            <span class="stat-label">Whenever you need it</span>
          </div>
        </div>
        <div class="hero-cta">
          <% if(!currentUser){ %>
          <a href="/signup" class="btn btn-primary btn-lg">Start collecting</a>
          <a href="/login" class="btn btn-outline-light btn-lg">I already have an account</a>
          <% } else { %>
          <a href="/bookmark/new" class="btn btn-primary btn-lg">Add a bookmark</a>
          <a href="/bookmark" class="btn btn-outline-light btn-lg">Open library</a>
          <% } %>
        </div>
      </div>
      <div class="hero-visual">
        <div class="bookmark-showcase">
          <div class="bookmark-card bookmark-card-1">
            <div class="bookmark-header">
              <i class="fas fa-code"></i>
              <span class="bookmark-category">Frontend</span>
            </div>
            <h4>React Documentation</h4>
            <p>Official docs, patterns, and the pages you always re-open.</p>
            <div class="bookmark-tags">
              <span class="tag">#react</span>
              <span class="tag">#javascript</span>
            </div>
          </div>
          <div class="bookmark-card bookmark-card-2">
            <div class="bookmark-header">
              <i class="fas fa-server"></i>
              <span class="bookmark-category">Backend</span>
            </div>
            <h4>Node.js API Guide</h4>
            <p>Endpoints, auth notes, and the stack you trust.</p>
            <div class="bookmark-tags">
              <span class="tag">#nodejs</span>
              <span class="tag">#api</span>
            </div>
          </div>
          <div class="bookmark-card bookmark-card-3">
            <div class="bookmark-header">
              <i class="fas fa-palette"></i>
              <span class="bookmark-category">Design</span>
            </div>
            <h4>CSS Grid Layout</h4>
            <p>Modern layout techniques, saved in one place.</p>
            <div class="bookmark-tags">
              <span class="tag">#css</span>
              <span class="tag">#layout</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="steps">
  <div class="container">
    <div class="section-header">
      <p class="page-kicker">How it works</p>
      <h2>Collect once. Find it forever.</h2>
      <p>A simple ritual for the resources you refuse to lose in a browser graveyard.</p>
    </div>
    <div class="steps-grid">
      <div class="step-item">
        <div class="step-num">01</div>
        <h3>Capture</h3>
        <p>Drop in a URL, title, and a few notes while the context is still fresh.</p>
      </div>
      <div class="step-item">
        <div class="step-num">02</div>
        <h3>Arrange</h3>
        <p>Tag by topic and file into collections so related work lives together.</p>
      </div>
      <div class="step-item">
        <div class="step-num">03</div>
        <h3>Return</h3>
        <p>Open your library later and pick up exactly where your curiosity left off.</p>
      </div>
    </div>
  </div>
</section>

<section class="features">
  <div class="container">
    <div class="section-header">
      <p class="page-kicker">Why Curate</p>
      <h2>Built for people who keep a lot of tabs — on purpose.</h2>
      <p>Less noise, more signal. A library that feels considered, not cluttered.</p>
    </div>
    <div class="features-grid">
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-layer-group"></i></div>
        <h3>Collections</h3>
        <p>Group related bookmarks into named sets you can reopen as a whole.</p>
      </div>
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-tags"></i></div>
        <h3>Thoughtful tags</h3>
        <p>Label resources the way you think — by stack, problem, or mood.</p>
      </div>
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-lock"></i></div>
        <h3>Private by default</h3>
        <p>Your notes and links stay with your account, not a public feed.</p>
      </div>
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-moon"></i></div>
        <h3>Light & dark</h3>
        <p>A warm editorial look that stays readable from desk to late night.</p>
      </div>
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-mobile-alt"></i></div>
        <h3>Anywhere</h3>
        <p>Responsive from the first screen, so the library travels with you.</p>
      </div>
      <div class="feature-item">
        <div class="feature-icon"><i class="fas fa-feather"></i></div>
        <h3>Quiet UI</h3>
        <p>No dashboards shouting for attention. Just the links you chose.</p>
      </div>
    </div>
  </div>
</section>

<% if(!currentUser){ %>
<section class="cta-section">
  <div class="container">
    <div class="cta-content">
      <h2>Start a library you’ll actually use.</h2>
      <p>Save the first link. The rest of your stack will follow.</p>
      <a href="/signup" class="btn btn-primary btn-lg">Create a free account</a>
    </div>
  </div>
</section>
<% } %>
