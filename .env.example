# Database
# Use a local database, never a hosted cluster. Always include the database name.
# Docker: docker run -d -p 27017:27017 mongodb/mongodb-atlas-local
MONGO_URI=mongodb://localhost:27017/curate_dev?directConnection=true

# Web session (server only)
SESSION_SECRET=change-me-in-production

# Extension API JWT (server only - never ship in the extension)
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# Optional public URL used in password-reset emails
APP_URL=http://localhost:3000

# Extension store listings
CHROME_STORE_URL=https://chromewebstore.google.com/detail/curate/nlkfmdiphacjgicdcagonbfnpcdjfapo
EDGE_STORE_URL=https://microsoftedge.microsoft.com/addons/detail/curate/ailonhflbailiggfiimmkkmbeoggbjpk

# Brevo SMTP (server only - never ship in the extension)
BREVO_SMTP_KEY=
BREVO_USER=
BREVO_FROM=

